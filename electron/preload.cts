import { contextBridge, ipcRenderer } from 'electron';
import type { RecorderAPI } from '../shared/api.js';
const api: RecorderAPI = {
  getAppInfo: () => ipcRenderer.invoke('app:info'),
  openMedia: () => ipcRenderer.invoke('media:open'),
  browseBackgrounds: () => ipcRenderer.invoke('background:browse'),
  targets: () => ipcRenderer.invoke('capture:targets'),
  startCapture: (id, options) => ipcRenderer.invoke('capture:start', id, options),
  stopCapture: () => ipcRenderer.invoke('capture:stop'),
  prepareStop: () => ipcRenderer.invoke('capture:prepare-stop'),
  cancelCapture: () => ipcRenderer.invoke('capture:cancel'),
  captureStatus: () => ipcRenderer.invoke('capture:status'),
  revealRecording: () => ipcRenderer.invoke('capture:reveal'),
  beginTrack: kind => ipcRenderer.invoke('track:begin', kind),
  appendTrack: (kind, data) => ipcRenderer.invoke('track:append', kind, data),
  endTrack: kind => ipcRenderer.invoke('track:end', kind),
  armLoopback: () => ipcRenderer.invoke('capture:arm-media'),
  onStopRequest: callback => { const listener = () => callback(); ipcRenderer.on('capture:stop-request', listener); return () => ipcRenderer.removeListener('capture:stop-request', listener); },
  requestStop: () => ipcRenderer.invoke('capture:request-stop'),
  addRecordingMarker: () => ipcRenderer.invoke('capture:marker'),
  onEditorShortcut: callback => { const listener = (_event: Electron.IpcRendererEvent, command: string) => callback(command); ipcRenderer.on('editor:shortcut', listener); return () => ipcRenderer.removeListener('editor:shortcut', listener); },
  saveProject: project => ipcRenderer.invoke('project:save', project),
  openProject: () => ipcRenderer.invoke('project:open'),
  exportProject: project => ipcRenderer.invoke('project:export', project),
  importProject: () => ipcRenderer.invoke('project:import'),
  importAnyProject: () => ipcRenderer.invoke('project:import-any'),
  listProjects: () => ipcRenderer.invoke('library:list'),
  saveLibrary: input => ipcRenderer.invoke('library:save', input),
  openLibrary: id => ipcRenderer.invoke('library:open', id),
  revealExport: () => ipcRenderer.invoke('export:reveal'),
  mediaSize: id => ipcRenderer.invoke('media:size', id),
  readMedia: (id, offset, length) => ipcRenderer.invoke('media:read', id, offset, length),
  startExport: input => ipcRenderer.invoke('export:start', input),
  exportFrame: (id, data) => ipcRenderer.invoke('export:frame', id, data),
  finishExport: id => ipcRenderer.invoke('export:finish', id),
  cancelExport: id => ipcRenderer.invoke('export:cancel', id),
};
contextBridge.exposeInMainWorld('recorder', Object.freeze(api));
